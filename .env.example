# Copy this file to .env on the VPS and edit values before starting Docker.

# Use ":80" for first boot without DNS/TLS, or app.callonfail.com.ar after DNS
# points to the VPS static IP.
APP_DOMAIN=:80
ACME_EMAIL=admin@callonfail.com.ar

POSTGRES_DB=callonfail
POSTGRES_USER=callonfail
POSTGRES_PASSWORD=change-this-password

LOG_LEVEL=INFO

# Keep 127.0.0.1 for safe default. For a short lab test from an ESP32 outside
# the VPS, set 0.0.0.0 and open port 1883 only temporarily.
MQTT_BIND_ADDRESS=127.0.0.1
