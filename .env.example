# Copy this file to .env on the VPS and edit values before starting Docker.

# Production web domain (HTTPS via Caddy / Let's Encrypt):
APP_DOMAIN=app.callonfail.com.ar
ACME_EMAIL=admin@callonfail.com.ar

POSTGRES_DB=callonfail
POSTGRES_USER=callonfail
POSTGRES_PASSWORD=change-this-password

LOG_LEVEL=INFO
APP_TIMEZONE=America/Argentina/Buenos_Aires
SECRET_KEY=change-this-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_COOKIE_SECURE=true

# MQTT hardening
# - Backend talks to Mosquitto inside Docker on 1883 with this user.
# - Devices connect publicly to mqtt.callonfail.com.ar:8883 with TLS.
# - Device username should match device_uid (ACL pattern devices/%u/#).
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=change-me-backend-mqtt
MQTT_DEVICE_USERNAME=cof-test
MQTT_DEVICE_PASSWORD=change-me-device-mqtt
MQTT_AUTO_PROVISION=false
MQTT_TLS_DOMAIN=mqtt.callonfail.com.ar
